{
  "name": "@grid-wolf/map",
  "packageManager": "yarn@4.4.1",
  "scripts": {
    "build": "esbuild ./lib/map-handler/index.ts --bundle --platform=node \"--external:@aws-sdk/*\" --outfile=./lib/map-handler/index.js",
    "test": "jest",
    "cdk": "cdk",
    "clean": "rm **/*.js",
    "deploy": "yarn build && yarn cdk deploy --require-approval never $0 $1 && yarn clean"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.656.0",
    "@aws-sdk/client-s3": "^3.658.1",
    "@aws-sdk/cloudfront-signer": "^3.654.0",
    "@aws-sdk/s3-request-presigner": "^3.658.1",
    "@grid-wolf/shared": "workspace:^",
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9",
    "@types/node": "^22.5.5",
    "@types/node-fetch": "2",
    "aws-cdk-lib": "2.160.0",
    "aws-cloudfront-sign": "^3.0.2",
    "aws-xray-sdk": "^3.10.1",
    "cdk": "2.160.0",
    "constructs": "10.3.0",
    "dotenv": "^16.4.7",
    "esbuild": "^0.24.2",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "2",
    "stepinto-aws-tools": "^0.7.10",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4"
  }
}
