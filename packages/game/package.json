{
  "name": "@grid-wolf/game",
  "packageManager": "yarn@4.4.1",
  "scripts": {
    "build:api-handler": "esbuild ./lib/game-handler/index.ts --bundle --platform=node \"--external:@aws-sdk/*\" --outfile=./lib/game-handler/index.js",
    "build:event-handler": "esbuild ./lib/game-event-handler/index.ts --bundle --platform=node \"--external:@aws-sdk/*\" --outfile=./lib/game-event-handler/index.js",
    "build": "yarn build:api-handler && yarn build:event-handler",
    "test": "jest",
    "cdk": "cdk",
    "clean": "rm **/*.js",
    "deploy": "yarn build && yarn cdk deploy --require-approval never $0 $1 && yarn clean"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.741.0",
    "@aws-sdk/client-eventbridge": "^3.749.0",
    "@grid-wolf/shared": "workspace:^",
    "@grid-wolf/user": "workspace:^",
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9",
    "@types/node": "^22.5.4",
    "aws-cdk-lib": "2.160.0",
    "aws-xray-sdk": "^3.9.0",
    "cdk": "2.160.0",
    "constructs": "10.3.0",
    "dotenv": "^16.4.7",
    "esbuild": "^0.24.2",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "stepinto-aws-tools": "^0.7.14",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4"
  }
}
